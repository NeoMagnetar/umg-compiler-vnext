{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,

    "rootDir": "src",
    "outDir": "dist",

    "declaration": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["scripts/**/*.ts", "tests", "snapshots", "node_modules", "dist"]
}