{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://umg.local/schemas/umg-compiler-vnext.schema.json",
  "$comment": "Structural JSON Schema for the experimental compiler-vnext reference. Cross-document/reference integrity and semantic laws are enforced by compiler validation, not JSON Schema alone.",
  "$defs": {
    "SourceProvenance": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "sourceVersion": {
          "type": "string",
          "minLength": 1
        },
        "sourceUri": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ScopeRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "sleeve"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "neostack"
            },
            "neoStackId": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "neoStackId"
          ]
        }
      ]
    },
    "MoltBlock": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "trigger",
            "directive",
            "instruction",
            "subject",
            "primary",
            "philosophy",
            "blueprint"
          ]
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "provenance": {
          "type": "object",
          "properties": {
            "sourceId": {
              "type": "string",
              "minLength": 1
            },
            "sourceVersion": {
              "type": "string",
              "minLength": 1
            },
            "sourceUri": {
              "type": "string",
              "minLength": 1
            },
            "notes": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "content"
      ]
    },
    "GeometryRow": {
      "type": "object",
      "properties": {
        "row": {
          "type": "integer",
          "minimum": 1
        },
        "blockIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "required": [
        "row",
        "blockIds"
      ]
    },
    "LaneGeometryMap": {
      "type": "object",
      "properties": {
        "trigger": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GeometryRow"
          },
          "minItems": 1
        },
        "directive": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GeometryRow"
          },
          "minItems": 1
        },
        "instruction": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GeometryRow"
          },
          "minItems": 1
        },
        "subject": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GeometryRow"
          },
          "minItems": 1
        },
        "primary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GeometryRow"
          },
          "minItems": 1
        },
        "philosophy": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GeometryRow"
          },
          "minItems": 1
        },
        "blueprint": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GeometryRow"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "MoltBundle": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "moltType": {
          "enum": [
            "instruction",
            "subject",
            "primary",
            "philosophy",
            "blueprint"
          ]
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GeometryRow"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "moltType",
        "rows"
      ]
    },
    "SecondaryDirective": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "directiveBlockId": {
          "type": "string",
          "minLength": 1
        },
        "triggerBlockId": {
          "type": "string",
          "minLength": 1
        },
        "bundles": {
          "type": "object",
          "properties": {
            "instruction": {
              "type": "string",
              "minLength": 1
            },
            "subject": {
              "type": "string",
              "minLength": 1
            },
            "primary": {
              "type": "string",
              "minLength": 1
            },
            "philosophy": {
              "type": "string",
              "minLength": 1
            },
            "blueprint": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "directiveBlockId",
        "triggerBlockId"
      ]
    },
    "MergeDeclaration": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sourceBlockIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "resultBlockId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "sourceBlockIds",
        "resultBlockId"
      ]
    },
    "NeoBlock": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "defaultState": {
          "enum": [
            "ready",
            "disabled"
          ]
        },
        "moltBlockIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "primeDirectiveId": {
          "type": "string",
          "minLength": 1
        },
        "secondaryDirectives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SecondaryDirective"
          },
          "minItems": 0
        },
        "baseGeometry": {
          "$ref": "#/$defs/LaneGeometryMap"
        },
        "bundles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MoltBundle"
          },
          "minItems": 0
        },
        "merges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MergeDeclaration"
          },
          "minItems": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "moltBlockIds",
        "primeDirectiveId",
        "baseGeometry"
      ]
    },
    "NeoBlockRow": {
      "type": "object",
      "properties": {
        "row": {
          "type": "integer",
          "minimum": 1
        },
        "neoBlockIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "required": [
        "row",
        "neoBlockIds"
      ]
    },
    "NeoStackRow": {
      "type": "object",
      "properties": {
        "row": {
          "type": "integer",
          "minimum": 1
        },
        "neoStackIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "required": [
        "row",
        "neoStackIds"
      ]
    },
    "NeoStack": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "skill": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "defaultState": {
          "enum": [
            "ready",
            "disabled"
          ]
        },
        "neoBlockRows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NeoBlockRow"
          },
          "minItems": 1
        },
        "childStackRows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NeoStackRow"
          },
          "minItems": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "skill",
        "neoBlockRows"
      ]
    },
    "ScopedMoltAttachment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "blockId": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "$ref": "#/$defs/ScopeRef"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "blockId",
        "scope"
      ]
    },
    "Overlay": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScopedMoltAttachment"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "attachments"
      ]
    },
    "GovernanceRule": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "offNeoStackIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "offNeoBlockIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description"
      ]
    },
    "Sleeve": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "umg.compiler-vnext.sleeve.v0.1"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "controllerNeoStackId": {
          "type": "string",
          "minLength": 1
        },
        "moltBlocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MoltBlock"
          },
          "minItems": 1
        },
        "neoBlocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NeoBlock"
          },
          "minItems": 1
        },
        "neoStacks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NeoStack"
          },
          "minItems": 1
        },
        "scopedMolt": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScopedMoltAttachment"
          },
          "minItems": 0
        },
        "overlays": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Overlay"
          },
          "minItems": 0
        },
        "governance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GovernanceRule"
          },
          "minItems": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "name",
        "controllerNeoStackId",
        "moltBlocks",
        "neoBlocks",
        "neoStacks"
      ]
    },
    "CompileSelection": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "umg.compiler-vnext.selection.v0.1"
        },
        "compiledAt": {
          "type": "string",
          "format": "date-time"
        },
        "activeNeoStackIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "activeNeoBlockIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "triggerState": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "activeOverlayIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "activeGovernanceRuleIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "disabledNeoStackIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "disabledNeoBlockIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "compiledAt",
        "activeNeoStackIds",
        "activeNeoBlockIds",
        "triggerState"
      ]
    },
    "CompilerDiagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "enum": [
            "error",
            "warning"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string"
        },
        "details": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "level",
        "message"
      ]
    },
    "TraceEvent": {
      "type": "object",
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "enum": [
            "SOURCE_VALIDATED",
            "VALIDATION_ERROR",
            "VALIDATION_WARNING",
            "NEOSTACK_ACTIVE",
            "NEOSTACK_READY",
            "NEOSTACK_DISABLED",
            "NEOSTACK_OFF",
            "NEOBLOCK_ACTIVE",
            "NEOBLOCK_READY",
            "NEOBLOCK_DISABLED",
            "NEOBLOCK_OFF",
            "TRIGGER_EVALUATED",
            "PRIME_DIRECTIVE_APPLIED",
            "SECONDARY_DIRECTIVE_SELECTED",
            "BASE_GEOMETRY_APPLIED",
            "BUNDLE_APPLIED",
            "MOLT_READY",
            "SCOPED_MOLT_APPLIED",
            "OVERLAY_APPLIED",
            "MERGE_VALIDATED",
            "GOVERNANCE_RULE_APPLIED",
            "RUNTIME_COMPILED",
            "POST_RUN_RESET_DECLARED"
          ]
        },
        "subjectId": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "required": [
        "seq",
        "type"
      ]
    },
    "Trace": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "umg.compiler-vnext.trace.v0.1"
        },
        "compilerVersion": {
          "type": "string",
          "minLength": 1
        },
        "sleeveId": {
          "type": "string",
          "minLength": 1
        },
        "compiledAt": {
          "type": "string",
          "format": "date-time"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TraceEvent"
          },
          "minItems": 0
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CompilerDiagnostic"
          },
          "minItems": 0
        },
        "finalNeoStackStates": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "ready",
              "active",
              "off",
              "disabled"
            ]
          }
        },
        "finalNeoBlockStates": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "ready",
              "active",
              "off",
              "disabled"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "compilerVersion",
        "sleeveId",
        "compiledAt",
        "events",
        "diagnostics",
        "finalNeoStackStates",
        "finalNeoBlockStates"
      ]
    },
    "ResolvedMoltBlock": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "trigger",
            "directive",
            "instruction",
            "subject",
            "primary",
            "philosophy",
            "blueprint"
          ]
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "sourceMode": {
          "enum": [
            "local",
            "scoped",
            "overlay",
            "merge"
          ]
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "sourceScope": {
          "$ref": "#/$defs/ScopeRef"
        },
        "overlayId": {
          "type": "string",
          "minLength": 1
        },
        "mergeId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "content",
        "sourceMode",
        "sourceId"
      ]
    },
    "ResolvedGeometryRow": {
      "type": "object",
      "properties": {
        "row": {
          "type": "integer",
          "minimum": 1
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResolvedMoltBlock"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "row",
        "blocks"
      ]
    },
    "ResolvedLane": {
      "type": "object",
      "properties": {
        "moltType": {
          "enum": [
            "trigger",
            "directive",
            "instruction",
            "subject",
            "primary",
            "philosophy",
            "blueprint"
          ]
        },
        "scoped": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResolvedMoltBlock"
          },
          "minItems": 0
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResolvedGeometryRow"
          },
          "minItems": 0
        },
        "geometrySource": {
          "enum": [
            "base",
            "bundle",
            "generated-directive-lane",
            "evaluated-trigger-lane"
          ]
        },
        "bundleId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "moltType",
        "scoped",
        "rows",
        "geometrySource"
      ]
    },
    "ResolvedNeoBlock": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "const": "active"
        },
        "postRunState": {
          "const": "ready"
        },
        "primeDirectiveId": {
          "type": "string",
          "minLength": 1
        },
        "secondaryDirectiveId": {
          "type": "string",
          "minLength": 1
        },
        "activeTriggerIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "lanes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResolvedLane"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "state",
        "postRunState",
        "primeDirectiveId",
        "activeTriggerIds",
        "lanes"
      ]
    },
    "PromptPart": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "trigger",
            "directive",
            "instruction",
            "subject",
            "primary",
            "philosophy",
            "blueprint"
          ]
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "sourceMode": {
          "enum": [
            "local",
            "scoped",
            "overlay",
            "merge"
          ]
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "sourceScope": {
          "$ref": "#/$defs/ScopeRef"
        },
        "overlayId": {
          "type": "string",
          "minLength": 1
        },
        "mergeId": {
          "type": "string",
          "minLength": 1
        },
        "neoStackId": {
          "type": "string",
          "minLength": 1
        },
        "neoBlockId": {
          "type": "string",
          "minLength": 1
        },
        "laneOrder": {
          "type": "integer",
          "minimum": 1
        },
        "scopeLayer": {
          "type": "integer",
          "minimum": 0
        },
        "row": {
          "type": "integer",
          "minimum": 0
        },
        "column": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "content",
        "sourceMode",
        "sourceId",
        "neoStackId",
        "neoBlockId",
        "laneOrder",
        "scopeLayer",
        "row",
        "column"
      ]
    },
    "ResetPlan": {
      "type": "object",
      "properties": {
        "neoStackIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "neoBlockIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "targetState": {
          "const": "ready"
        }
      },
      "additionalProperties": false,
      "required": [
        "neoStackIds",
        "neoBlockIds",
        "targetState"
      ]
    },
    "RuntimeSpec": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "umg.compiler-vnext.runtime.v0.1"
        },
        "compilerVersion": {
          "type": "string",
          "minLength": 1
        },
        "sleeveId": {
          "type": "string",
          "minLength": 1
        },
        "sleeveName": {
          "type": "string",
          "minLength": 1
        },
        "controllerNeoStackId": {
          "type": "string",
          "minLength": 1
        },
        "compiledAt": {
          "type": "string",
          "format": "date-time"
        },
        "activeNeoStackIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "resolvedNeoBlocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResolvedNeoBlock"
          },
          "minItems": 0
        },
        "promptParts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PromptPart"
          },
          "minItems": 0
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CompilerDiagnostic"
          },
          "minItems": 0
        },
        "runtimeHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "resetPlan": {
          "$ref": "#/$defs/ResetPlan"
        }
      },
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "compilerVersion",
        "sleeveId",
        "sleeveName",
        "controllerNeoStackId",
        "compiledAt",
        "activeNeoStackIds",
        "resolvedNeoBlocks",
        "promptParts",
        "diagnostics",
        "runtimeHash",
        "resetPlan"
      ]
    },
    "CompileResult": {
      "type": "object",
      "properties": {
        "runtime": {
          "$ref": "#/$defs/RuntimeSpec"
        },
        "trace": {
          "$ref": "#/$defs/Trace"
        },
        "hasErrors": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "trace",
        "hasErrors"
      ]
    }
  }
}
